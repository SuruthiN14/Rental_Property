<%@ page contentType="text/html;charset=UTF-8" %><html><head><title>Rental Request</title><link rel="stylesheet" href="css/style.css"></head><body><div class="nav"><div class="brand">⌂ Rental Property</div><div class="navlinks"><a href="properties">Properties</a><a href="logout">Logout</a></div></div><div class="card form-card"><h2>Submit Rental Request</h2><p class="small">Property ID: <%=request.getParameter("propertyId")%></p><form method="post" action="rentalRequest"><input type="hidden" name="propertyId" value="<%=request.getParameter("propertyId")%>"><div class="form-group"><label>Tenant Name</label><input name="tenantName" value="<%=session.getAttribute("name")!=null?session.getAttribute("name"):""%>" required></div><div class="form-group"><label>Phone</label><input name="phone" required></div><div class="form-group"><label>Message</label><textarea name="message" placeholder="I am interested in renting this property."></textarea></div><button class="btn" type="submit">Submit Request</button></form></div></body></html>
