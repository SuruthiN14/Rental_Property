<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%@ page import="com.rentalproperty.model.Property" %><html><head><title>Properties</title><link rel="stylesheet" href="css/style.css"></head><body><div class="nav"><div class="brand">⌂ Rental Property</div><div class="navlinks"><a href="index.jsp">Home</a><a href="login.jsp">Login</a><a href="register.jsp">Register</a></div></div><div class="container"><h2>Available Properties</h2><form class="filter" method="get" action="properties"><input name="location" placeholder="Select location"><select name="type"><option value="All">All Types</option><option>Apartment</option><option>Villa</option><option>House</option></select><input name="min" type="number" placeholder="Min Rent"><input name="max" type="number" placeholder="Max Rent"><button class="btn" type="submit">Search</button></form><div class="grid"><% List<Property> list=(List<Property>)request.getAttribute("properties"); for(Property rs:list){ %><div class="card property-card"><img class="property-img" src="images/<%=rs.getImage()%>"><h3><%=rs.getTitle()%></h3><div class="meta">📍 <%=rs.getLocation()%> · <%=rs.getBedrooms()%> Bedrooms</div><p class="price">₹ <%=rs.getRent()%> / month</p><p class="meta"><%=rs.getType()%> · <%=rs.getStatus()%></p><a class="btn" href="propertyDetails?id=<%=rs.getId()%>">View Details</a></div><% } %></div></div></body></html>
