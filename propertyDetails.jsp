<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="com.rentalproperty.model.Property" %><html><head><title>Property Details</title><link rel="stylesheet" href="css/style.css"></head><body><div class="nav"><div class="brand">⌂ Rental Property</div><div class="navlinks"><a href="properties">Properties</a><a href="login.jsp">Login</a></div></div><div class="container"><% Property p=(Property)request.getAttribute("property"); if(p!=null){ %><div class="card detail"><div><img src="images/<%=p.getImage()%>"></div><div><h1><%=p.getTitle()%></h1><p class="meta">📍 <%=p.getLocation()%> · <%=p.getType()%> · <%=p.getBedrooms()%> Bedrooms</p><p class="price">₹ <%=p.getRent()%> / month</p><h3>Description</h3><p><%=p.getDescription()%></p><p><b>Status:</b> <%=p.getStatus()%></p><a class="btn" href="rentalRequest.jsp?propertyId=<%=p.getId()%>">Request Rent</a></div></div><% } else { %><div class="alert">Property not found.</div><% } %></div></body></html>
