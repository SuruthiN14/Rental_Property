<%@ page contentType="text/html;charset=UTF-8" %><html><head><title>Add Property</title><link rel="stylesheet" href="css/style.css"></head><body><div class="nav"><div class="brand">⌂ Rental Property</div><div class="navlinks"><a href="OwnerDashboardServlet">Dashboard</a><a href="logout">Logout</a></div></div><div class="card form-card"><h2>Add Property</h2><%if(request.getParameter("error")!=null){%><div class="alert"><%=request.getParameter("error")%></div><%}%><form action="addProperty" method="post"><div class="form-group"><label>Title</label><input name="title" placeholder="2 BHK Apartment" required></div><div class="form-group"><label>Location</label><input name="location" placeholder="Madurai" required></div><div class="form-group"><label>Type</label><select name="type"><option>Apartment</option><option>Villa</option><option>House</option></select></div><div class="form-group"><label>Rent (₹/month)</label><input type="number" name="rent" min="1" required></div><div class="form-group"><label>Bedrooms</label><input type="number" name="bedrooms" min="1" required></div><div class="form-group"><label>Image</label><select name="image"><option value="house1.svg">House Image 1</option><option value="house2.svg">House Image 2</option><option value="house3.svg">House Image 3</option></select></div><div class="form-group"><label>Description</label><textarea name="description" required></textarea></div><button class="btn" type="submit">Submit</button></form></div></body></html>
