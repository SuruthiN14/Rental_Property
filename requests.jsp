<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*" %><%@ page import="com.rentalproperty.model.RentalRequest" %><html><head><title>Rental Requests</title><link rel="stylesheet" href="css/style.css"></head><body><div class="nav"><div class="brand">⌂ Rental Property</div><div class="navlinks"><a href="OwnerDashboardServlet">Dashboard</a><a href="logout">Logout</a></div></div><div class="container"><h2>Rental Requests</h2><div class="table-wrap"><table class="table"><tr><th>ID</th><th>Property</th><th>Tenant</th><th>Phone</th><th>Date</th><th>Status</th><th>Action</th></tr><%List<RentalRequest> list=(List<RentalRequest>)request.getAttribute("requests");for(RentalRequest rs:list){%><tr><td><%=rs.getId()%></td><td><%=rs.getTitle()%></td><td><%=rs.getTenantName()%></td><td><%=rs.getPhone()%></td><td><%=rs.getDate()%></td><td><b><%=rs.getStatus()%></b></td><td><form method="post" action="updateRequest"><input type="hidden" name="requestId" value="<%=rs.getId()%>"><select name="status"><option <%=rs.getStatus().equals("Pending")?"selected":""%>>Pending</option><option <%=rs.getStatus().equals("Approved")?"selected":""%>>Approved</option><option <%=rs.getStatus().equals("Rejected")?"selected":""%>>Rejected</option></select><button class="btn" type="submit">Update</button></form></td></tr><%}%></table></div></div></body></html>
